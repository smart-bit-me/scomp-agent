# scomp-demo.service — an always-on demo host for App Store / Google Play review.
#
# It runs the fakeshellonly agent build, which is not published as a release
# asset; build it from a release tag (`GOOS=linux GOARCH=amd64 make
# build-fakeshell`, or arm64). That binary offers three simulated
# sessions — shell, agent, logs — and links no PTY, tmux or Screen code, so
# nothing a reviewer types can execute anything (see docs/FAKESHELL.md).
# No tmux, bash or other package is needed on the host.
#
# The sandbox below is defence in depth for the agent's own network code:
# an unprivileged system user, a read-only system, no new executables, and
# daily resets (RuntimeMaxSec).
#
# Install (the user comes from sysusers.d, so it exists on the host even while
# the service is stopped; pairing and file ownership rely on that):
#   sudo install -m 0755 bin/scomp-fakeshell /usr/local/bin/scomp-fakeshell
#   sudo restorecon -v /usr/local/bin/scomp-fakeshell     # SELinux hosts
#   sudo install -m 0644 demo/scomp-demo.sysusers /etc/sysusers.d/scomp-demo.conf
#   sudo systemd-sysusers /etc/sysusers.d/scomp-demo.conf && id scomp-demo
#   sudo install -d -o scomp-demo -g scomp-demo -m 0700 /var/lib/scomp-demo
#   sudo install -m 0644 demo/scomp-demo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Pair once with the review account, as the same user and HOME as the service
# (the agent asks for the PIN on stdin):
#   sudo -u scomp-demo HOME=/var/lib/scomp-demo /usr/local/bin/scomp-fakeshell
#   In the app, signed in as the review account: Pair -> enter the printed UID,
#   then type the PIN into this terminal. Press Ctrl-C once it is paired.
#   The identity is stored under /var/lib/scomp-demo/.config/scomp/fakeshell/.
#
# Run:   sudo systemctl enable --now scomp-demo
# Logs:  journalctl -u scomp-demo -f

[Unit]
Description=Scomp demo host for app review (simulated sessions only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scomp-demo
Group=scomp-demo
StateDirectory=scomp-demo
Environment=HOME=%S/scomp-demo
WorkingDirectory=%S/scomp-demo

# --hostname defaults to review-host in fakeshell mode.
ExecStart=/usr/local/bin/scomp-fakeshell --no-qr
Restart=always
RestartSec=5
RuntimeMaxSec=1d

# Sandbox.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Nothing but the agent itself may be executed.
NoExecPaths=/
ExecPaths=/usr/local/bin/scomp-fakeshell
PrivateTmp=yes
RemoveIPC=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryMax=128M
TasksMax=32
CPUQuota=25%

[Install]
WantedBy=multi-user.target
